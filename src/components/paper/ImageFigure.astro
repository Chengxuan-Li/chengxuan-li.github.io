---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ActionButton from '../ActionButton.astro';
interface Props { src: ImageMetadata; alt: string; caption: string; number: number }
const {src,alt,caption,number}=Astro.props;
---
<figure class="paper-image" id={`figure-${number}`}>
  <figcaption class="paper-caption">
    <span class="caption-text"><a href={`#figure-${number}`}>Figure {number}.</a> {caption}</span>
    <span class="caption-actions">
      <ActionButton href={src.src} icon="expand" label={`Expand Figure ${number}`} iconOnly data-enlarge-image data-image-alt={alt} />
      <ActionButton href={src.src} icon="image" label={`Download Figure ${number} image`} iconOnly download />
    </span>
  </figcaption>
  <a href={src.src} data-enlarge-image aria-label={`Enlarge Figure ${number}`}><Image src={src} alt={alt} widths={[800,1600,2465]} sizes="(max-width: 60rem) 95vw, 900px" /></a>
</figure>
