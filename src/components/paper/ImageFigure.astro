---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { src: ImageMetadata; alt: string; caption: string; number: number }
const {src,alt,caption,number}=Astro.props;
---
<figure class="paper-image" id={`figure-${number}`}>
  <a href={src.src} data-enlarge-image aria-label={`Enlarge Figure ${number}`}><Image src={src} alt={alt} widths={[800,1600,2465]} sizes="(max-width: 60rem) 95vw, 900px" /></a>
  <figcaption><a href={`#figure-${number}`}>Figure {number}.</a> {caption}</figcaption>
</figure>
