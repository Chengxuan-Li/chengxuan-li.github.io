---
import type { ProjectEntry, PublicationEntry } from '../../lib/content/model';
import { getText, type Locale } from '../../lib/i18n';
import '../../styles/paper.css';
interface Props { project: ProjectEntry; publication: PublicationEntry; headings: {depth: number; slug: string; text: string}[]; locale: Locale }
const {project, publication, headings, locale} = Astro.props;
const title = getText(project.data.title);
const authors = publication.data.authors;
const venue = publication.data.venue ? getText(publication.data.venue) : '';
const statusLabel = publication.data.status === 'accepted' ? 'Accepted manuscript' : publication.data.status === 'published' ? 'Published paper' : 'Author manuscript';
const citation = `${authors.join(', ')}. ${publication.data.year}. ${title}. ${publication.data.venue ? getText(publication.data.venue) + '. ' : ''}Author manuscript.`;
const bibtex = `@${publication.data.type === 'journal' ? 'article' : 'inproceedings'}{${project.id}${publication.data.year},\n  title={${title}},\n  author={${authors.join(' and ')}},\n  ${publication.data.type === 'journal' ? 'journal' : 'booktitle'}={${venue}},\n  year={${publication.data.year}},\n  note={${statusLabel}}\n}`;
---
<article class="paper-reader" lang="en">
  <header class="paper-head" id="paper-top">
    <p class="paper-publication">{venue}{venue && ' · '}{statusLabel}</p>
    <h1>{title}</h1>
    <p class="paper-authors">{authors.map((name, i) => <Fragment>{i > 0 && ', '}{name}<sup>1{i === 0 ? ', *' : ''}</sup></Fragment>)}</p>
    <p class="paper-affiliation"><sup>1</sup> <a href="https://es.aap.cornell.edu/">Environmental Systems Lab</a>, College of Architecture, Art and Planning, Cornell University</p>
    <p class="paper-correspondence">* Corresponding author: <a href="mailto:cl2749@cornell.edu">cl2749@cornell.edu</a></p>
    <div class="paper-actions">
      {project.data.paper_pdf && <a href={project.data.paper_pdf} download>Download PDF</a>}
      <button type="button" data-print class="js-control">Print paper</button>
      <a href="#paper-citation">Cite this paper</a>
    </div>
    {locale === 'zh' && <p class="paper-language" lang="zh-CN">论文保留英文原文；交互图表基于论文对应的实验数据。</p>}
  </header>
  <div class="paper-layout">
    <aside class="paper-toc" aria-label="Paper navigation">
      <details open><summary>Contents</summary><nav>{headings.filter(h => h.depth === 2).map(h => <a href={`#${h.slug}`}>{h.text}</a>)}<a href="#paper-citation">Citation & data</a></nav></details>
      <a class="paper-top-link" href="#paper-top">Back to title</a>
    </aside>
    <div class="paper-content">
      <slot />
      <section class="paper-citation" id="paper-citation">
        <h2>Citation & data</h2><p>{citation}</p>
        <div class="paper-actions"><button type="button" data-copy-citation class="js-control">Copy BibTeX</button><a href="/data/shadingzip/provenance.json" download>Data provenance</a></div>
        <pre class="bibtex"><code>{bibtex}</code></pre>
        <p class="paper-note">This HTML edition preserves the supplied manuscript. Interactive figures reproduce the cap-300 experiment. Figure controls change the view of saved results; they do not run new simulations. The original PDF remains available above.</p>
      </section>
    </div>
  </div>
  <div class="reference-preview" role="tooltip" id="reference-preview" hidden></div>
  <p class="paper-status" role="status" aria-live="polite"></p>
</article>
<script>import '../../lib/paper/reader';</script>
