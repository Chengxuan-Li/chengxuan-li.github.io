---
import type { ActivityEntry } from '../lib/content/activity';
import { formatDayMonth, formatMonthYear } from '../lib/content/format';
import { htmlLang, type Locale } from '../lib/i18n';

interface Props {
  entry: ActivityEntry;
  /** `compact` for the home page and project activity lists; `full` for the news page. */
  variant?: 'compact' | 'full';
  locale?: Locale;
}

const { entry, variant = 'compact', locale = 'en' } = Astro.props;
// Year-only dates render no day column: the year heading above the entry already carries that information.
const dayMonth = formatDayMonth(entry.date, locale);
const titleLang = entry.titleLang === htmlLang(locale) ? undefined : entry.titleLang;
const summaryLang = entry.summaryLang === htmlLang(locale) ? undefined : entry.summaryLang;
---
{variant === 'compact' ? (
  <li class="news-item news-item--compact">
    <time class="news-item__date" datetime={entry.date}>{formatMonthYear(entry.date, locale)}</time>
    <div class="news-item__body">
      <p class="news-item__title" lang={titleLang}>{entry.href ? <a href={entry.href}>{entry.title}</a> : entry.title}</p>
      {entry.links.length > 0 && (
        <ul class="news-item__links">
          {entry.links.map((link) => <li><a href={link.href}>{link.label} →</a></li>)}
        </ul>
      )}
    </div>
  </li>
) : (
  <li class="news-item news-item--full">
    <div class="news-item__when">
      {dayMonth && <time datetime={entry.date}>{dayMonth}</time>}
      <span class="news-item__type">{entry.label}</span>
    </div>
    <div class="news-item__body">
      <h3 class="news-item__title" lang={titleLang}>{entry.href ? <a href={entry.href}>{entry.title}</a> : entry.title}</h3>
      {entry.summary && <p class="news-item__summary" lang={summaryLang}>{entry.summary}</p>}
      {entry.links.length > 0 && (
        <ul class="news-item__links">
          {entry.links.map((link) => <li><a href={link.href}>{link.label} →</a></li>)}
        </ul>
      )}
    </div>
  </li>
)}
