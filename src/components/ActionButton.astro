---
import type { HTMLAttributes } from 'astro/types';
import type { ActionIconName } from '../lib/action-icons';
import ActionIcon from './ActionIcon.astro';

type Props = Omit<HTMLAttributes<'a'>, 'children'> & {
  icon: ActionIconName;
  label: string;
  disabled?: boolean;
  iconOnly?: boolean;
  size?: 'default' | 'small';
};

const { icon, label, href, disabled = false, iconOnly = false, size = 'default', class: className, ...attributes } = Astro.props;
const Element = href && !disabled ? 'a' : 'button';
const destination = href?.toString() ?? '';
const isDownload = attributes.download !== undefined && attributes.download !== false;
const opensPage = destination !== '' && !destination.startsWith('#') && !/^(mailto:|tel:)/i.test(destination) && !isDownload && attributes['data-enlarge-image'] === undefined;
const target = attributes.target ?? (opensPage ? '_blank' : undefined);
const rel = target === '_blank'
  ? [...new Set(`${attributes.rel ?? ''} noopener noreferrer`.trim().split(/\s+/))].join(' ')
  : attributes.rel;
---
<Element
  {...attributes}
  class:list={['action-button', { 'action-button--icon-only': iconOnly, 'action-button--small': size === 'small' }, className]}
  title={attributes.title ?? (iconOnly ? label : undefined)}
  href={Element === 'a' ? href : undefined}
  target={Element === 'a' ? target : undefined}
  rel={Element === 'a' ? rel : undefined}
  type={Element === 'button' ? 'button' : undefined}
  disabled={Element === 'button' ? disabled : undefined}
>
  <ActionIcon name={icon} />
  <span class:list={{ 'visually-hidden': iconOnly }}>{label}</span>
</Element>

<style>
  .action-button {
    --action-background: var(--accent);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: .45rem;
    min-height: 2.4rem;
    padding: .5rem .85rem;
    border: 1px solid var(--accent);
    border-radius: 2px;
    background: var(--action-background);
    color: var(--on-accent);
    font-family: var(--font-sans);
    font-size: .875rem;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: normal;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition: background-color 150ms ease, border-color 150ms ease;
  }
  .action-button:hover:not(:disabled) {
    --action-background: var(--accent-ink);
    background: var(--action-background);
    border-color: var(--accent-ink);
    color: var(--on-accent);
  }
  .action-button:disabled { opacity: .45; cursor: not-allowed; }
  .action-button--small { min-height: 1.85rem; padding: .25rem .5rem; font-size: .8rem; }
  .action-button--icon-only {
    --action-background: transparent;
    width: 1.85rem;
    min-height: 1.85rem;
    padding: .3rem;
    border-color: transparent;
    background: var(--action-background);
    color: var(--ink-2);
  }
  .action-button--icon-only:hover:not(:disabled) { --action-background: var(--paper-2); background: var(--action-background); border-color: transparent; color: var(--ink); }
</style>
