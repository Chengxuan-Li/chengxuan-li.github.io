---
import type { AwardEntry, ProjectEntry } from '../lib/content/model';
import { formatFlexDate } from '../lib/content/format';
import { fallbackLang, getText, localizedPath, t, type Locale } from '../lib/i18n';

interface Props {
  award: AwardEntry;
  projects?: ProjectEntry[];
  locale?: Locale;
}

const { award, projects = [], locale = 'en' } = Astro.props;
const { data } = award;
const title = getText(data.title, locale);
const organization = getText(data.organization, locale);
---
<li class="cv-item">
  <p class="cv-item__when">{formatFlexDate(data.date, 'full', locale)}</p>
  <div class="cv-item__what">
    <p class="cv-item__title"><strong lang={fallbackLang(data.title, locale)}>{data.url ? <a href={data.url}>{title}</a> : title}</strong> · <span class="cv-item__org" lang={fallbackLang(data.organization, locale)}>{organization}</span></p>
    {data.description && <p class="cv-item__summary" lang={fallbackLang(data.description, locale)}>{getText(data.description, locale)}</p>}
    {projects.length > 0 && (
      <ul class="cv-item__links" aria-label={t(locale, 'aria.relatedProjects')}>
        {projects.map((project) => <li><a href={localizedPath(`/projects/${project.id}/`, locale)}>{getText(project.data.short_title ?? project.data.title, locale)} →</a></li>)}
      </ul>
    )}
  </div>
</li>
