---
import type { AwardEntry, ProjectEntry } from '../lib/content/model';
import { formatFlexDate } from '../lib/content/format';

interface Props {
  award: AwardEntry;
  projects?: ProjectEntry[];
}

const { award, projects = [] } = Astro.props;
const { data } = award;
---
<li class="cv-item">
  <p class="cv-item__when">{formatFlexDate(data.date)}</p>
  <div class="cv-item__what">
    <p class="cv-item__title"><strong>{data.url ? <a href={data.url}>{data.title}</a> : data.title}</strong> · <span class="cv-item__org">{data.organization}</span></p>
    {data.description && <p class="cv-item__summary">{data.description}</p>}
    {projects.length > 0 && (
      <ul class="cv-item__links" aria-label="Related projects">
        {projects.map((project) => <li><a href={`/projects/${project.id}/`}>{project.data.short_title ?? project.data.title} →</a></li>)}
      </ul>
    )}
  </div>
</li>
