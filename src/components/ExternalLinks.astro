---
import { siteConfig } from '../site.config';
import { localizedPath, t, type Locale } from '../lib/i18n';

interface Props {
  variant?: 'hero' | 'footer' | 'cv';
  includeCv?: boolean;
  locale?: Locale;
}

const { variant = 'hero', includeCv = false, locale = 'en' } = Astro.props;
const { profiles } = siteConfig;

const links: { label: string; href: string; external: boolean }[] = [];
if (includeCv) links.push({ label: t(locale, 'nav.cv'), href: localizedPath('/cv/', locale), external: false });
if (profiles.github) links.push({ label: 'GitHub', href: profiles.github, external: true });
if (profiles.scholar) links.push({ label: 'Scholar', href: profiles.scholar, external: true });
if (profiles.linkedin) links.push({ label: 'LinkedIn', href: profiles.linkedin, external: true });
if (profiles.email) links.push({ label: locale === 'zh' ? '邮箱' : 'Email', href: `mailto:${profiles.email}`, external: false });
---
{links.length > 0 && (
  <ul class:list={['links', `links--${variant}`]} aria-label={t(locale, 'aria.profiles')}>
    {links.map((link) => (
      <li>
        <a href={link.href} rel={link.external ? 'me noopener' : undefined}>{link.label}</a>
      </li>
    ))}
  </ul>
)}
