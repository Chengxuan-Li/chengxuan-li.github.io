---
import { siteConfig } from '../site.config';
import { t, type Locale } from '../lib/i18n';
import ActionButton from './ActionButton.astro';
import ActionGroup from './ActionGroup.astro';
import type { ActionIconName } from '../lib/action-icons';

interface Props {
  variant?: 'hero' | 'footer' | 'cv';
  includeCv?: boolean;
  locale?: Locale;
}

const { variant = 'hero', includeCv = false, locale = 'en' } = Astro.props;
const { profiles } = siteConfig;

const links: { label: string; href: string; external: boolean; icon: ActionIconName }[] = [];
const primaryCv = siteConfig.cvPdfs.find((cv) => cv.primary) ?? siteConfig.cvPdfs[0];
if (includeCv && primaryCv) links.push({ label: t(locale, 'nav.cv'), href: primaryCv.href, external: false, icon: 'pdf' });
if (profiles.github) links.push({ label: 'GitHub', href: profiles.github, external: true, icon: 'github' });
if (profiles.scholar) links.push({ label: 'Scholar', href: profiles.scholar, external: true, icon: 'website' });
if (profiles.linkedin) links.push({ label: 'LinkedIn', href: profiles.linkedin, external: true, icon: 'linkedin' });
if (profiles.email) links.push({ label: locale === 'zh' ? '邮箱' : 'Email', href: `mailto:${profiles.email}`, external: false, icon: 'email' });
---
{links.length > 0 && (
  <ActionGroup class={`links links--${variant}`} label={t(locale, 'aria.profiles')}>
    {links.map((link) => (
      <ActionButton href={link.href} label={link.label} icon={link.icon} rel={link.external ? 'me noopener' : undefined} />
    ))}
  </ActionGroup>
)}
