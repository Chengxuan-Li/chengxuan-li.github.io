---
import type { ProjectEntry } from '../lib/content/model';
import { formatDateRange, PROJECT_STATUS_LABELS, PROJECT_TYPE_LABELS } from '../lib/content/format';
import TagList from './TagList.astro';

interface Props {
  project: ProjectEntry;
}

const { project } = Astro.props;
const { data } = project;
const period = formatDateRange(data.start_date, data.end_date, { present: 'present' });
---
<dl class="project-meta">
  <div><dt>Period</dt><dd>{period}</dd></div>
  <div><dt>Status</dt><dd>{PROJECT_STATUS_LABELS[data.status]}</dd></div>
  {data.affiliation && <div><dt>Affiliation</dt><dd>{data.affiliation}</dd></div>}
  {data.types.length > 0 && <div><dt>Type</dt><dd>{data.types.map((type) => PROJECT_TYPE_LABELS[type]).join(' · ')}</dd></div>}
  {data.technologies.length > 0 && <div><dt>Technologies</dt><dd>{data.technologies.join(' · ')}</dd></div>}
</dl>
<TagList items={data.topics} label="Topics" />
{data.links.length > 0 && (
  <ul class="project-links" aria-label="Project links">
    {data.links.map((link) => <li><a class="button" href={link.url}>{link.label}</a></li>)}
  </ul>
)}
