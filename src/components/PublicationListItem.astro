---
import type { ProjectEntry, PublicationEntry } from '../lib/content/model';
import { formatVenueLine, publicationStatusLabel, splitAuthors } from '../lib/content/format';
import { fallbackLang, getText, localizedPath, t, type Locale } from '../lib/i18n';
import { siteConfig } from '../site.config';

interface Props {
  publication: PublicationEntry;
  /** Projects to link to; pass nothing on a project page to avoid a self-link. */
  projects?: ProjectEntry[];
  locale?: Locale;
}

const { publication, projects = [], locale = 'en' } = Astro.props;
const { data } = publication;
const authors = splitAuthors(data.authors, siteConfig.nameVariants);
const doiHref = data.doi ? `https://doi.org/${data.doi}` : undefined;
const primaryHref = data.links.paper ?? data.links.preprint ?? doiHref;
const statusLabel = data.status === 'published' ? undefined : publicationStatusLabel(data.status, locale);
const venueLine = formatVenueLine(data.venue ? getText(data.venue, locale) : null, data.year);
const title = getText(data.title, locale);

const links: { label: string; href: string }[] = [];
if (data.links.paper) links.push({ label: t(locale, 'label.paper'), href: data.links.paper });
if (data.links.preprint) links.push({ label: t(locale, 'label.preprint'), href: data.links.preprint });
if (doiHref) links.push({ label: 'DOI', href: doiHref });
if (data.links.code) links.push({ label: t(locale, 'label.code'), href: data.links.code });
if (data.links.slides) links.push({ label: t(locale, 'label.slides'), href: data.links.slides });
if (data.links.poster) links.push({ label: t(locale, 'label.poster'), href: data.links.poster });
for (const project of projects) {
  links.push({ label: `${t(locale, 'label.projectLink')}: ${getText(project.data.short_title ?? project.data.title, locale)}`, href: localizedPath(`/projects/${project.id}/`, locale) });
}
---
<li class="pub" id={`pub-${publication.id}`}>
  <p class="pub__authors">
    {authors.map((author, index) => (
      <Fragment><span class:list={{ pub__self: author.isSelf }}>{author.name}</span>{index < authors.length - 1 ? ', ' : ''}</Fragment>
    ))}
  </p>
  <p class="pub__title" lang={fallbackLang(data.title, locale)}>{primaryHref ? <a href={primaryHref}>{title}</a> : title}</p>
  <p class="pub__venue">{venueLine}{statusLabel && <span class="pub__status"> · {statusLabel}</span>}</p>
  {data.note && <p class="pub__note" lang={fallbackLang(data.note, locale)}>{getText(data.note, locale)}</p>}
  {links.length > 0 && (
    <ul class="pub__links">
      {links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
    </ul>
  )}
</li>
