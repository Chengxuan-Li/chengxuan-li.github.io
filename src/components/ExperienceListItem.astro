---
import type { ExperienceEntry, ProjectEntry } from '../lib/content/model';
import { formatDateRange } from '../lib/content/format';

interface Props {
  experience: ExperienceEntry;
  projects?: ProjectEntry[];
  /** `compact` (home) shows role, organization, dates, summary; `full` (CV) adds bullets and project links. */
  variant?: 'compact' | 'full';
}

const { experience, projects = [], variant = 'compact' } = Astro.props;
const { data } = experience;
---
<li class="cv-item">
  <p class="cv-item__when">{formatDateRange(data.start_date, data.end_date)}</p>
  <div class="cv-item__what">
    <p class="cv-item__title"><strong>{data.role}</strong> · <span class="cv-item__org">{data.url ? <a href={data.url}>{data.organization}</a> : data.organization}</span>{data.location && <span class="cv-item__org"> · {data.location}</span>}</p>
    {data.summary && <p class="cv-item__summary">{data.summary}</p>}
    {variant === 'full' && data.bullets.length > 0 && (
      <ul class="cv-item__bullets">
        {data.bullets.map((bullet) => <li>{bullet}</li>)}
      </ul>
    )}
    {variant === 'full' && projects.length > 0 && (
      <ul class="cv-item__links" aria-label="Related projects">
        {projects.map((project) => <li><a href={`/projects/${project.id}/`}>{project.data.short_title ?? project.data.title} →</a></li>)}
      </ul>
    )}
  </div>
</li>
