---
import type { ActionIconName } from '../lib/action-icons';

interface Props { name: ActionIconName }
const { name } = Astro.props;
const social = name === 'github' || name === 'linkedin';
const paths = {
  github: 'M9 19v-2.3c0-.7.2-1.2.6-1.6C7.1 14.8 5 13.7 5 10.3c0-1.2.4-2.2 1.1-3-.3-1-.2-2 .1-2.9 1.3 0 2.4.5 3.3 1.2a10.5 10.5 0 0 1 5 0c.9-.7 2-1.2 3.3-1.2.4 1 .4 1.9.1 2.9.7.8 1.1 1.8 1.1 3 0 3.4-2.1 4.5-4.6 4.8.4.4.6.9.6 1.6V19ZM9 18c-3.2.9-3.4-1.5-4.9-2-.7-.3-.8-.8-.1-.9.9-.1 1.7.4 2.2 1.2.5.7 1.6.9 2.8.5Z',
  linkedin: 'M6 10h2.5v8H6ZM7.25 6a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3ZM10 10h2.4v1.1c.6-.9 1.5-1.4 2.7-1.4 2.6 0 3.2 1.7 3.2 4V18h-2.6v-4c0-1.2-.2-2.1-1.5-2.1s-1.7.9-1.7 2.1v4H10Z',
  email: 'M3 5h18v14H3zM3 6l9 7 9-7',
  website: 'M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0ZM3 12h18M12 3c-5 5-5 13 0 18 5-5 5-13 0-18Z',
  printer: 'M6 9V3h12v6M6 17H3V9h18v8h-3M6 14h12v7H6zM17 11h.01',
  quote: 'M6 17h3l2-4V7H5v6h3l-2 4Zm10 0h3l2-4V7h-6v6h3l-2 4Z',
  presentation: 'M3 3h18v13H3zM8 21l4-5 4 5M12 16v5M7 12l3-3 3 2 4-5',
  copy: 'M9 9h12v12H9zM15 9V3H3v12h6',
  code: 'm8 5-7 7 7 7m8-14 7 7-7 7M14 3l-4 18',
  data: 'M3 6c0-4 18-4 18 0s-18 4-18 0Zm0 0v12c0 4 18 4 18 0V6M3 12c0 4 18 4 18 0',
  expand: 'M8 3H3v5M16 3h5v5M3 16v5h5M21 16v5h-5M3 3l6 6M21 3l-6 6M3 21l6-6M21 21l-6-6',
  download: 'M12 3v12m-5-5 5 5 5-5M4 16v5h16v-5',
  image: 'M3 3h18v18H3zM3 17l5-5 4 4 3-3 6 6M15 7h.01',
  return: 'm9 4-6 6 6 6M3 10h11a7 7 0 0 1 7 7v3',
  close: 'M6 6l12 12M18 6 6 18',
};
---
{name === 'svg' ? (
  <span class="action-icon action-icon--text" aria-hidden="true">SVG</span>
) : name === 'pdf' ? (
  <span class="action-icon action-icon--pdf" aria-hidden="true"></span>
) : social ? (
  <svg class="action-icon" viewBox="0 0 24 24" fill="var(--paper)" stroke="none" aria-hidden="true" focusable="false">
    <path fill-rule="evenodd" d={`M22.5 12a10.5 10.5 0 1 1-21 0 10.5 10.5 0 1 1 21 0Z ${paths[name]}`} />
  </svg>
) : (
  <svg class="action-icon" viewBox="0 0 24 24" fill={name === 'quote' ? 'currentColor' : 'none'} stroke={name === 'quote' ? 'none' : 'currentColor'} stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    <path d={paths[name]} />
  </svg>
)}

<style>
  .action-icon { width: 1.1rem; height: 1.1rem; flex: 0 0 auto; }
  .action-icon--text { display: inline-flex; align-items: center; justify-content: center; font-family: var(--font-sans); font-size: .55rem; font-weight: 700; line-height: 1; }
  .action-icon--pdf {
    background: currentColor;
    mask: url('/icons/pdf-icon.svg') center / contain no-repeat;
    -webkit-mask: url('/icons/pdf-icon.svg') center / contain no-repeat;
  }
</style>
