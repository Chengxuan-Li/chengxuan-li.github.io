---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  widths?: number[];
  sizes?: string;
  loading?: 'eager' | 'lazy';
}

const {
  src,
  alt,
  caption,
  widths = [640, 960, 1280, 1600],
  sizes = '(max-width: 76em) 100vw, 71rem',
  loading = 'lazy',
} = Astro.props;
---
<figure class="figure">
  <Image src={src} alt={alt} widths={widths} sizes={sizes} loading={loading} />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
