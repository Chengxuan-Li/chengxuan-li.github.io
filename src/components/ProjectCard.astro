---
import { Image } from 'astro:assets';
import TagList from './TagList.astro';
import type { ProjectEntry } from '../lib/content/model';
import { formatDateRange, projectStatusLabel, projectTypeLabel } from '../lib/content/format';
import { fallbackLang, getText, localizedPath, t, type Locale } from '../lib/i18n';

interface Props {
  project: ProjectEntry;
  /** `featured` (home: image, title, one sentence, ≤4 topics, secondary links) or `index` (adds dates, status, types, technologies). */
  variant?: 'featured' | 'index';
  headingLevel?: 2 | 3;
  locale?: Locale;
}

const { project, variant = 'index', headingLevel = 3, locale = 'en' } = Astro.props;
const { data } = project;
const href = localizedPath(`/projects/${project.id}/`, locale);
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const isFeatured = variant === 'featured';
const secondaryLinks = isFeatured ? data.links.filter((link) => ['paper', 'code', 'demo'].includes(link.kind)).slice(0, 3) : [];
const topics = isFeatured ? data.topics.slice(0, 4) : data.topics;
const dateRange = formatDateRange(data.start_date, data.end_date, { locale });
---
<article class:list={['project-card', `project-card--${variant}`]}>
  <a class="project-card__visual" href={href} tabindex="-1" aria-hidden="true">
    {data.hero_image ? (
      <Image
        src={data.hero_image}
        alt=""
        widths={[480, 800, 1200]}
        sizes="(max-width: 44em) 100vw, (max-width: 76em) 50vw, 36rem"
        loading={isFeatured ? 'eager' : 'lazy'}
      />
    ) : (
      <span class="project-card__fallback"><span lang={fallbackLang(data.short_title ?? data.title, locale)}>{getText(data.short_title ?? data.title, locale)}</span></span>
    )}
  </a>
  <div class="project-card__body">
    <Heading class="project-card__title" lang={fallbackLang(data.title, locale)}><a href={href}>{getText(data.title, locale)}</a></Heading>
    {!isFeatured && <p class="project-card__meta">{dateRange} · {projectStatusLabel(data.status, locale)}</p>}
    <p class="project-card__summary" lang={fallbackLang(data.summary, locale)}>{getText(data.summary, locale)}</p>
    {!isFeatured && data.types.length > 0 && (
      <TagList items={data.types.map((type) => projectTypeLabel(type, locale))} variant="type" label={t(locale, 'label.projectType')} locale={locale} />
    )}
    <TagList items={topics} label={t(locale, 'label.topics')} locale={locale} />
    {!isFeatured && data.technologies.length > 0 && <p class="tech-line">{data.technologies.join(' · ')}</p>}
    <div class="project-card__actions">
      <a class="project-card__primary" href={href}>{t(locale, 'action.viewProject')} →</a>
      {secondaryLinks.map((link) => <a class="project-card__secondary" href={link.url} lang={fallbackLang(link.label, locale)}>{getText(link.label, locale)}</a>)}
    </div>
  </div>
</article>
