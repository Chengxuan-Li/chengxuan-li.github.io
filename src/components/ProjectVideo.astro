---
import type { ProjectVideoData } from '../lib/content/model';
import { resolveExternalVideoUrl } from '../lib/content/video';
import { fallbackLang, getText, t, type Locale } from '../lib/i18n';

interface Props {
  video: ProjectVideoData;
  locale?: Locale;
  variant?: 'standalone' | 'showcase';
}

const { video, locale = 'en', variant = 'standalone' } = Astro.props;
const source = resolveExternalVideoUrl(video.url);
if (!source) throw new Error(`Unsupported project video URL: ${video.url}`);
const title = getText(video.title, locale);
---
<figure class:list={['project-media', { 'project-media--showcase': variant === 'showcase' }]}>
  {variant === 'standalone' && <h3 lang={fallbackLang(video.title, locale)}>{title}</h3>}
  {source.kind === 'embed' ? (
    <iframe
      src={source.url}
      title={title}
      loading="lazy"
      allow="fullscreen; picture-in-picture"
      allowfullscreen
      referrerpolicy="strict-origin-when-cross-origin"
    ></iframe>
  ) : (
    <video
      class:list={{ 'project-media__video--cover': video.fit === 'cover' }}
      controls
      playsinline
      preload="metadata"
      poster={video.poster?.src}
      aria-label={title}
      data-autoplay={video.autoplay ? '' : undefined}
      muted={video.autoplay}
      loop={video.autoplay}
      autoplay={video.autoplay && variant === 'showcase'}
    >
      <source src={source.url} type={source.mimeType} />
      <p>{t(locale, 'media.unsupported')} <a href={source.url}>{t(locale, 'media.open')}</a></p>
    </video>
  )}
  {video.caption && <figcaption lang={fallbackLang(video.caption, locale)}>{getText(video.caption, locale)}</figcaption>}
</figure>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        const video = entry.target as HTMLVideoElement;
        if (entry.isIntersecting && entry.intersectionRatio >= 0.35) {
          void video.play().catch(() => {});
        } else {
          video.pause();
        }
      }
    },
    { threshold: [0, 0.35] },
  );

  document.querySelectorAll<HTMLVideoElement>('video[data-autoplay]').forEach((video) => {
    video.muted = true;
    if (!reduceMotion.matches || video.autoplay) observer.observe(video);
  });
</script>

<style>
  .project-media--showcase { margin: 0; }
  .project-media--showcase video,
  .project-media--showcase iframe { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: contain; }
</style>
