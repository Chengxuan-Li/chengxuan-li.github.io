---
import type { ProjectEntry, TalkEntry } from '../lib/content/model';
import { formatFlexDate, talkTypeLabel } from '../lib/content/format';
import { fallbackLang, getText, localizedPath, t, type Locale } from '../lib/i18n';

interface Props {
  talk: TalkEntry;
  projects?: ProjectEntry[];
  locale?: Locale;
}

const { talk, projects = [], locale = 'en' } = Astro.props;
const { data } = talk;
const where = [getText(data.event, locale), data.location ? getText(data.location, locale) : undefined].filter(Boolean).join(', ');

const links: { label: string; href: string }[] = [];
if (data.links.slides) links.push({ label: t(locale, 'label.slides'), href: data.links.slides });
if (data.links.video) links.push({ label: t(locale, 'label.video'), href: data.links.video });
if (data.links.abstract) links.push({ label: t(locale, 'label.abstract'), href: data.links.abstract });
if (data.links.event) links.push({ label: t(locale, 'label.event'), href: data.links.event });
for (const project of projects) {
  links.push({ label: `${t(locale, 'label.projectLink')}: ${getText(project.data.short_title ?? project.data.title, locale)}`, href: localizedPath(`/projects/${project.id}/`, locale) });
}
---
<li class="cv-item">
  <p class="cv-item__when">{formatFlexDate(data.date, 'full', locale)}</p>
  <div class="cv-item__what">
    <p class="cv-item__title"><strong lang={fallbackLang(data.title, locale)}>{getText(data.title, locale)}</strong></p>
    <p class="cv-item__summary">{talkTypeLabel(data.type, locale)} · {where}</p>
    {links.length > 0 && (
      <ul class="cv-item__links">
        {links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
      </ul>
    )}
  </div>
</li>
