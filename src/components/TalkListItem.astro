---
import type { ProjectEntry, TalkEntry } from '../lib/content/model';
import { formatFlexDate, TALK_TYPE_LABELS } from '../lib/content/format';

interface Props {
  talk: TalkEntry;
  projects?: ProjectEntry[];
}

const { talk, projects = [] } = Astro.props;
const { data } = talk;
const where = [data.event, data.location].filter(Boolean).join(', ');

const links: { label: string; href: string }[] = [];
if (data.links.slides) links.push({ label: 'Slides', href: data.links.slides });
if (data.links.video) links.push({ label: 'Video', href: data.links.video });
if (data.links.abstract) links.push({ label: 'Abstract', href: data.links.abstract });
if (data.links.event) links.push({ label: 'Event', href: data.links.event });
for (const project of projects) {
  links.push({ label: `Project: ${project.data.short_title ?? project.data.title}`, href: `/projects/${project.id}/` });
}
---
<li class="cv-item">
  <p class="cv-item__when">{formatFlexDate(data.date)}</p>
  <div class="cv-item__what">
    <p class="cv-item__title"><strong>{data.title}</strong></p>
    <p class="cv-item__summary">{TALK_TYPE_LABELS[data.type]} · {where}</p>
    {links.length > 0 && (
      <ul class="cv-item__links">
        {links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
      </ul>
    )}
  </div>
</li>
