---
import type { NewsEntry } from '../lib/content/model';
import type { NewsRelations } from '../lib/content/queries';
import { formatDayMonth, formatMonthYear, NEWS_TYPE_LABELS } from '../lib/content/format';

interface Props {
  item: NewsEntry;
  relations: NewsRelations;
  /** `compact` for the home page and project activity lists; `full` for the news page. */
  variant?: 'compact' | 'full';
}

const { item, relations, variant = 'compact' } = Astro.props;
const { data } = item;

const links: { label: string; href: string }[] = [
  ...relations.projects.map((project) => ({
    label: project.data.short_title ?? project.data.title,
    href: `/projects/${project.id}/`,
  })),
  ...relations.publications.flatMap((publication) => {
    const href = publication.data.links.paper ?? publication.data.links.preprint;
    return href ? [{ label: 'Paper', href }] : [];
  }),
  ...relations.talks.flatMap((talk) => [
    ...(talk.data.links.slides ? [{ label: 'Slides', href: talk.data.links.slides }] : []),
    ...(talk.data.links.video ? [{ label: 'Video', href: talk.data.links.video }] : []),
  ]),
  ...relations.awards.flatMap((award) => (award.data.url ? [{ label: 'Award', href: award.data.url }] : [])),
  ...data.links.map((link) => ({ label: link.label, href: link.url })),
];
---
{variant === 'compact' ? (
  <li class="news-item news-item--compact">
    <time class="news-item__date" datetime={data.date}>{formatMonthYear(data.date)}</time>
    <div class="news-item__body">
      <p class="news-item__title">{data.title}</p>
      {links.length > 0 && (
        <ul class="news-item__links">
          {links.map((link) => <li><a href={link.href}>{link.label} →</a></li>)}
        </ul>
      )}
    </div>
  </li>
) : (
  <li class="news-item news-item--full">
    <div class="news-item__when">
      <time datetime={data.date}>{formatDayMonth(data.date)}</time>
      <span class="news-item__type">{NEWS_TYPE_LABELS[data.type]}</span>
    </div>
    <div class="news-item__body">
      <h3 class="news-item__title">{data.title}</h3>
      {data.summary && <p class="news-item__summary">{data.summary}</p>}
      {links.length > 0 && (
        <ul class="news-item__links">
          {links.map((link) => <li><a href={link.href}>{link.label} →</a></li>)}
        </ul>
      )}
    </div>
  </li>
)}
