---
import BaseLayout from '../layouts/BaseLayout.astro';
import ExternalLinks from '../components/ExternalLinks.astro';
import SectionHeading from '../components/SectionHeading.astro';
import EducationListItem from '../components/EducationListItem.astro';
import ExperienceListItem from '../components/ExperienceListItem.astro';
import PublicationListItem from '../components/PublicationListItem.astro';
import TalkListItem from '../components/TalkListItem.astro';
import AwardListItem from '../components/AwardListItem.astro';
import { loadSiteContent } from '../lib/content/load';
import { formatDateRange } from '../lib/content/format';
import {
  getProjectsByIds,
  getPublicationProjects,
  groupExperiencesByType,
  sortAwards,
  sortEducation,
  sortProjectsForIndex,
  sortPublications,
  sortSkills,
  sortTalks,
} from '../lib/content/queries';
import { roleLine, siteConfig } from '../site.config';

const content = await loadSiteContent();
const education = sortEducation(content.education);
const experiences = groupExperiencesByType(content.experiences);
const projects = sortProjectsForIndex(content.projects);
const publications = sortPublications(content.publications);
const talks = sortTalks(content.talks);
const awards = sortAwards(content.awards);
const skills = sortSkills(content.skills);

const sections = [
  { id: 'interests', title: 'Research interests', show: siteConfig.researchInterests !== null },
  { id: 'education', title: 'Education', show: education.length > 0 },
  { id: 'research-experience', title: 'Research experience', show: experiences.research.length > 0 },
  { id: 'professional-experience', title: 'Professional experience', show: experiences.professional.length > 0 },
  { id: 'projects', title: 'Selected projects', show: projects.length > 0 },
  { id: 'publications', title: 'Publications', show: publications.length > 0 },
  { id: 'talks', title: 'Presentations', show: talks.length > 0 },
  { id: 'awards', title: 'Awards', show: awards.length > 0 },
  { id: 'teaching', title: 'Teaching', show: experiences.teaching.length > 0 },
  { id: 'skills', title: 'Technical skills', show: skills.length > 0 },
  { id: 'service', title: 'Service', show: experiences.service.length > 0 },
].filter((section) => section.show);

const description = `Curriculum vitae of ${siteConfig.name}: education, research and professional experience, projects, publications, presentations, and awards.`;
---
<BaseLayout title="CV" description={description}>
  <header class="page-head cv-head">
    <h1>Curriculum vitae</h1>
    <p class="cv-head__identity"><strong>{siteConfig.name}</strong> · {roleLine()}, {siteConfig.affiliation}</p>
    <div class="cv-head__actions">
      <ExternalLinks variant="cv" />
      {siteConfig.cvPdf && <a class="button button--primary" href={siteConfig.cvPdf}>Download PDF CV</a>}
    </div>
    {sections.length > 1 && (
      <nav class="cv-toc" aria-label="CV sections">
        <ul>
          {sections.map((section) => <li><a href={`#${section.id}`}>{section.title}</a></li>)}
        </ul>
      </nav>
    )}
  </header>

  {sections.length === 0 && <p class="empty-state">The full record will appear here as entries are published.</p>}

  {siteConfig.researchInterests && (
    <section class="cv-section" aria-labelledby="interests">
      <SectionHeading id="interests" title="Research interests" />
      <p class="cv-interests">{siteConfig.researchInterests}</p>
    </section>
  )}

  {education.length > 0 && (
    <section class="cv-section" aria-labelledby="education">
      <SectionHeading id="education" title="Education" />
      <ol class="cv-list">
        {education.map((entry) => <EducationListItem education={entry} variant="full" />)}
      </ol>
    </section>
  )}

  {experiences.research.length > 0 && (
    <section class="cv-section" aria-labelledby="research-experience">
      <SectionHeading id="research-experience" title="Research experience" />
      <ol class="cv-list">
        {experiences.research.map((entry) => (
          <ExperienceListItem experience={entry} projects={getProjectsByIds(content, entry.data.project_ids)} variant="full" />
        ))}
      </ol>
    </section>
  )}

  {experiences.professional.length > 0 && (
    <section class="cv-section" aria-labelledby="professional-experience">
      <SectionHeading id="professional-experience" title="Professional experience" />
      <ol class="cv-list">
        {experiences.professional.map((entry) => (
          <ExperienceListItem experience={entry} projects={getProjectsByIds(content, entry.data.project_ids)} variant="full" />
        ))}
      </ol>
    </section>
  )}

  {projects.length > 0 && (
    <section class="cv-section" aria-labelledby="projects">
      <SectionHeading id="projects" title="Selected projects" action={{ href: '/projects/', label: 'All projects' }} />
      <ol class="cv-list">
        {projects.map((project) => (
          <li class="cv-item">
            <p class="cv-item__when">{formatDateRange(project.data.start_date, project.data.end_date, { present: 'present' })}</p>
            <div class="cv-item__what">
              <p class="cv-item__title"><a href={`/projects/${project.id}/`}>{project.data.title}</a></p>
              <p class="cv-item__summary">{project.data.summary}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>
  )}

  {publications.length > 0 && (
    <section class="cv-section" aria-labelledby="publications">
      <SectionHeading id="publications" title="Publications" />
      <ol class="pub-list">
        {publications.map((publication) => (
          <PublicationListItem publication={publication} projects={getPublicationProjects(content, publication)} />
        ))}
      </ol>
    </section>
  )}

  {talks.length > 0 && (
    <section class="cv-section" aria-labelledby="talks">
      <SectionHeading id="talks" title="Presentations" />
      <ol class="cv-list">
        {talks.map((talk) => <TalkListItem talk={talk} projects={getProjectsByIds(content, talk.data.project_ids)} />)}
      </ol>
    </section>
  )}

  {awards.length > 0 && (
    <section class="cv-section" aria-labelledby="awards">
      <SectionHeading id="awards" title="Awards" />
      <ol class="cv-list">
        {awards.map((award) => <AwardListItem award={award} projects={getProjectsByIds(content, award.data.project_ids)} />)}
      </ol>
    </section>
  )}

  {experiences.teaching.length > 0 && (
    <section class="cv-section" aria-labelledby="teaching">
      <SectionHeading id="teaching" title="Teaching" />
      <ol class="cv-list">
        {experiences.teaching.map((entry) => (
          <ExperienceListItem experience={entry} projects={getProjectsByIds(content, entry.data.project_ids)} variant="full" />
        ))}
      </ol>
    </section>
  )}

  {skills.length > 0 && (
    <section class="cv-section" aria-labelledby="skills">
      <SectionHeading id="skills" title="Technical skills" />
      <ul class="cv-list skills-list">
        {skills.map((group) => (
          <li class="cv-item">
            <p class="cv-item__when">{group.data.category}</p>
            <div class="cv-item__what">
              <p class="cv-item__title">{group.data.items.join(' · ')}</p>
            </div>
          </li>
        ))}
      </ul>
    </section>
  )}

  {experiences.service.length > 0 && (
    <section class="cv-section" aria-labelledby="service">
      <SectionHeading id="service" title="Service" />
      <ol class="cv-list">
        {experiences.service.map((entry) => (
          <ExperienceListItem experience={entry} projects={getProjectsByIds(content, entry.data.project_ids)} variant="full" />
        ))}
      </ol>
    </section>
  )}
</BaseLayout>
