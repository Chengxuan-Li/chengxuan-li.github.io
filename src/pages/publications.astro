---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationListItem from '../components/PublicationListItem.astro';
import { loadSiteContent } from '../lib/content/load';
import { getPublicationProjects, groupPublicationsByYear, sortPublications } from '../lib/content/queries';
import { siteConfig } from '../site.config';

const content = await loadSiteContent();
const groups = groupPublicationsByYear(content.publications);
const total = sortPublications(content.publications).length;
const description = `Peer-reviewed papers, conference proceedings, and preprints by ${siteConfig.name}.`;
---
<BaseLayout title="Publications" description={description}>
  <header class="page-head">
    <h1>Publications</h1>
    <p class="page-head__lede">
      Selected publications.
    </p>
  </header>
  {total === 0 ? (
    <p class="empty-state">Publications will appear here as they are released.</p>
  ) : (
    groups.map((group) => (
      <section class="pub-year" aria-labelledby={`year-${group.year}`}>
        <h2 id={`year-${group.year}`} class="news-year__heading">{group.year}</h2>
        <ol class="pub-list">
          {group.items.map((publication) => (
            <PublicationListItem publication={publication} projects={getPublicationProjects(content, publication)} />
          ))}
        </ol>
      </section>
    ))
  )}
</BaseLayout>
