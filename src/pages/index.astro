---
// Temporary placeholder; replaced by the real home page in Task 8. Loading content here makes
// `astro build` run schema + cross-reference validation even before the pages exist.
import { loadSiteContent } from '../lib/content/load';
import { siteConfig } from '../site.config';

const content = await loadSiteContent();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{siteConfig.name}</title>
  </head>
  <body>
    <h1>{siteConfig.name}</h1>
    <p>{content.projects.length} projects loaded.</p>
  </body>
</html>
