---
import BaseLayout from '../layouts/BaseLayout.astro';
import ExternalLinks from '../components/ExternalLinks.astro';
import { loadSiteContent } from '../lib/content/load';
import { roleLine, siteConfig } from '../site.config';

// Loaded here so that content validation runs on every build; the remaining home sections use it in Task 8.
await loadSiteContent();
---
<BaseLayout title={`${siteConfig.name} — ${roleLine()}`} description={siteConfig.description} titleTemplate={false}>
  <section class="hero" aria-labelledby="hero-name">
    <h1 id="hero-name" class="hero__name">{siteConfig.name}</h1>
    <p class="hero__role">{roleLine()}</p>
    <p class="hero__affiliation">{siteConfig.affiliation}</p>
    <p class="hero__positioning">{siteConfig.positioning}</p>
    <ExternalLinks variant="hero" includeCv />
  </section>
</BaseLayout>
