---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { getCollection } from 'astro:content';
import ProjectPage from '../../views/ProjectPage.astro';
import { loadSiteContent } from '../../lib/content/load';

export const getStaticPaths = (async () => {
  await loadSiteContent();
  const projects = await getCollection('projects');
  return projects.filter((project) => project.data.published).map((project) => ({ params: { slug: project.id }, props: { project } }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { project } = Astro.props as Props;
---
<ProjectPage project={project} locale="en" />
