---
import BaseLayout from '../layouts/BaseLayout.astro';
import ActivityListItem from '../components/ActivityListItem.astro';
import { loadSiteContent } from '../lib/content/load';
import { buildActivityStream, groupActivityByYear } from '../lib/content/activity';
import { siteConfig } from '../site.config';

const content = await loadSiteContent();
const groups = groupActivityByYear(buildActivityStream(content));
---
<BaseLayout title="News" description={`Papers, talks, awards, and other activity from ${siteConfig.name}, most recent first.`}>
  <header class="page-head">
    <h1>News</h1>
    <p class="page-head__lede">
      Papers, talks, awards, and everything else worth noting, recent first.
    </p>
  </header>
  {groups.length === 0 ? (
    <p class="empty-state">Updates will appear here as they are published.</p>
  ) : (
    groups.map((group) => (
      <section class="news-year" aria-labelledby={`year-${group.year}`}>
        <h2 id={`year-${group.year}`} class="news-year__heading">{group.year}</h2>
        <ol class="news-list news-list--full">
          {group.items.map((entry) => <ActivityListItem entry={entry} variant="full" />)}
        </ol>
      </section>
    ))
  )}
</BaseLayout>
