{
  "name": "chengxuan-li.github.io",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:fixtures": "node scripts/with-fixtures.mts dev",
    "build": "astro build --force && node scripts/check-dist.mts",
    "build:fixtures": "node scripts/with-fixtures.mts build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "validate": "npm run check && npm run test && npm run build",
    "brand-assets": "node scripts/generate-brand-assets.mts",
    "paper-data": "node scripts/prepare-shadingzip.mts"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.0",
    "@astrojs/mdx": "8.0.0",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/noto-serif-sc": "5.3.0",
    "astro": "7.3.1",
    "d3-dsv": "3.0.1",
    "d3-scale": "4.0.2",
    "d3-shape": "3.2.0",
    "katex": "0.18.7",
    "sharp": "0.35.4",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/d3-dsv": "3.0.7",
    "@types/d3-scale": "4.0.9",
    "@types/d3-shape": "3.2.0",
    "@types/katex": "0.16.8",
    "@types/node": "^24.0.0",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}
